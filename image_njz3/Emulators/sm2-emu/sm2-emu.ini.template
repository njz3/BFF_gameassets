# sm2-emu settings.
#
# Every setting below is at its default. Anything given on the command
# line overrides what is here, and anything missing here keeps its
# default, so deleting a line is the same as never writing it.

# Wait for the display's vertical blank before presenting. Off can tear
# but shows a frame as soon as it is ready.
vsync = false

# Hold the machine to its own 57.5245 Hz. Off runs as fast as this
# computer manages, which is only useful for captures and benchmarks.
throttle = true

fullscreen = {{PLEIN_ECRAN}}
# Fenetre sans bordure a la resolution du bureau, sans changement de mode
# video : le defaut de sm2-emu, ecrit ici pour qu on le voie.
borderless_fullscreen = true
show_fps = false
# Software renderer: draw on a second thread, one frame behind.
software_async = true
# With software_async on a big.LITTLE CPU, draw on the slow cores.
software_slow_cores = true
show_notifications = false
# Overlay language: auto (follow the system), en, or a file name from
# lang/ without .po (de, pt_BR, zh_TW, ...).
language = auto
lightgun = false
lightgun_crosshair = true
lightgun_hide_flash = false
lightgun_recoil = true
lightgun_recoil_strength = 60
sinden_border = false
sinden_border_colour = 0xffffff
sinden_border_thickness = 12
window_width = {{LARGEUR}}
window_height = {{HAUTEUR}}

# Internal 3D render scale (1..8). 1 is native 496x384; higher
# renders the 3D pass at N times that for crisper geometry. GPU
# backends only (the software renderer stays native), and it takes
# effect on the next launch.
render_scale = {{ECHELLE_RENDU}}

# How the finished frame is scaled to the window. One of: nearest,
# bilinear, sharp (sharp-bilinear), integer. Sharp keeps 2D text crisp
# without the shimmer nearest gives at non-integer window sizes.
# Present-stage only, so it takes effect live.
scaling_method = {{METHODE_ECHELLE}}

# Aspect the frame is presented at. One of: 4:3 (arcade monitor),
# square (raw 496x384 square pixels), stretch (fill the window),
# 16:9 (widescreen: the 3D drawn wider, GPU renderers only).
aspect_mode = {{ASPECT}}
# Etire le cadre de l image a toute la fenetre : vrai en super-resolution
# (1024x384, 1280x240, 1280x480, 1920x240), ou l image 4:3 doit remplir
# l ecran. Colonne ETIRER de resolutions.csv.
display_stretch = {{ETIRER}}

# Optional CRT cosmetic filter over the finished frame. Strengths are
# 0..100; curvature 0 is flat. Live-switchable.
crt_enabled = false
crt_scanline_strength = 40
crt_mask_strength = 30
crt_glow_strength = 20
crt_curvature = 0

# Opt-in graphics enhancement beyond the original hardware. Defaults
# match the arcade; each is GPU-gated and falls back to faithful.
# texture_filter: faithful or anisotropic (sharper 3D at grazing
# angles); anisotropy is the 2..16 tap ceiling, clamped to the GPU.
# upscale_2d: faithful, xbr or scalefx (edge-smooth the 2D layers).
# translucency: stipple (the hardware's checkerboard) or blended
# (the 50% see-through it's trying to achieve: lights, glass,
# shadows).
# extended_draw_distance: draw the scenery to the edge of the
# course instead of the arcade's short range (Daytona USA).
texture_filter = faithful
anisotropy = 4
upscale_2d = {{UPSCALE_2D}}
translucency = blended
extended_draw_distance = false

# Custom textures: images in <saves>/textures/<game>/load named as
# dumped replace the game's own, at any whole multiple of the size.
# dump_textures writes every texture drawn, with a browsable
# index.html, to <saves>/textures/<game>/dump when the game exits.
custom_textures = true
dump_textures = false

# Exact device name as --list-gpus prints it. Empty picks the best one.
gpu = 

# Renderer: software, vulkan or opengl (whichever the build has).
# Empty picks the build default. Applies on the next launch.
graphics_backend = 

# Cabinet link (networking). Links this instance to other cabinets on
# the LAN running the same linked title (Sega Rally, Daytona, Super GT
# 24h, Indy 500, ...). Off keeps the single-cabinet loopback. The comms
# board is a ring: each cabinet receives on its own address and sends
# to the next one; for two machines they point at each other. The
# master/slave role is still set in the game's own test menu.
link_enabled = {{LINK_ACTIF}}
# This cabinet's own address. link_local_ip empty binds every
# interface; it is prefilled from the primary NIC on first run.
# link_subnet_mask is informational (shown in the GUI).
link_local_ip = {{IP_LOCALE}}
link_subnet_mask = {{MASQUE}}
link_port = 15112
# The next cabinet in the ring: where this instance sends. Empty
# link_next_ip disables sending.
link_next_ip = {{IP_SUIVANTE}}
link_next_port = 15112
# Where this cabinet sits in the ring, 0-based (bookkeeping only).
link_cabinet_index = {{INDEX_CABINET}}
# link_mode : buffered = carte reseau simulee portee de Supermodel. Toutes
# les bornes d un meme anneau doivent avoir la MEME version de sm2-emu et le
# MEME mode. Le link passe alors en TCP sur link_port. Le defaut de sm2-emu
# reste original ; l image prend buffered (proprietaire, 24/10/2026).
link_mode = buffered

# Wheels and gamepads keep working while the window is not in front.
# Keyboard and mouse still need the window in front.
input_background = true
# Steering-wheel force feedback: a synthesised centring spring (the
# drive board is not emulated, so this is a feel, not the real motor
# force). Strength is 0..100 percent of the wheel's maximum torque.
wheel_ffb = true
wheel_ffb_strength = {{FORCE_FFB}}
# Sega Rally Championship and Daytona USA only, all their versions:
# their panel's light centring spring, 0..100 percent of the strength
# above. The other games' panels have none.
wheel_panel_spring = 20
# Indy 500, Touring Car, Over Rev and Super GT 24h: the drive board's
# power (0..63) that gives no torque yet, and the one that gives the
# wheel's full strength. 0 and 63: the torque in proportion to the
# power, as the board sends it to the motor drive board.
wheel_indy_deadband = 0
wheel_indy_full_power = 63
# The drive board's DIP switches for the motor's strength, 0..7 (0 all
# OFF): Sega Rally and Daytona switches 1-3, Indy 500's family 1-1..1-3.
wheel_drive_dip = 0
# Reverses the force, for a wheel whose driver pushes the wrong way:
# one that pulls away from the centre instead of bringing it back.
wheel_ffb_invert = false
# Wheel rumble, for wheels without force feedback: vibrates on the
# game's impacts. wheel_rumble_engine adds a vibration that grows with
# the throttle; it is not from the game.
wheel_rumble = true
wheel_rumble_strength = 40
wheel_rumble_engine = true

# Gamepad rumble in driving games: vibrates on the game's impacts.
# pad_rumble_cornering adds a vibration that grows as you steer; it is
# not from the game.
pad_rumble = true
pad_rumble_strength = 60
pad_rumble_cornering = true
# Stick sensitivity past the deadzone, percent (25..300). Full
# deflection is always full lock; under 100 the middle of the travel
# does less, over 100 it does more.
pad_stick_sensitivity = 100
# Stick travel about centre that reads as centre, percent (0..40).
# Raise it for a stick that no longer settles at rest.
pad_stick_deadzone = 5
# Cabinet lamps and drive-board bytes for MAMEHooker, DOFLinx and
# similar tools, in MAME's formats: over TCP (network) and, on
# Windows, as window messages. With the network outputs on, a starting
# game is also announced over UDP to outputs_network_udp_port, as
# Supermodel does on 8001, which BackForceFeeder waits for; 0 turns
# the announcement off.
outputs_network = true
outputs_network_port = 8000
outputs_network_udp_port = 8001
# The racing games' telemetry (cars, race), one JSON line a frame to
# every TCP client on this port; 0 serves nothing.
telemetry_port = 0
outputs_windows = false
# Your wheel's own physical rotation range (a G-series PC wheel is
# ~900). The cabinet's ~240 of lock is mapped onto it, so matching
# your wheel gives arcade-like response.
wheel_steer_degrees = 270
# Physical rotation (total) at which the game reaches full lock;
# lower is more sensitive. 180..270.
wheel_lock_degrees = 270
# Wheel travel about centre that reads as centre, percent (0..20).
wheel_steer_deadzone = 0
# Which wheel button drives each control (numbering varies by wheel;
# -1 unbinds). Set these in the GUI's Wheel tab. Buttons 1..4 are the
# arcade buttons, which is where a cabinet's VR/view buttons land too.
wheel_button_start = 3
wheel_button_coin = 0
wheel_button_1 = 4
wheel_button_2 = 5
wheel_button_3 = 6
wheel_button_4 = 7
wheel_button_gear_up = 8
wheel_button_gear_down = 9
wheel_button_test = 1
wheel_button_service = 2
wheel_button_menu = 10
# An H shifter's positions, one button each, on the games with a gate
# gearbox (Daytona USA, Sega Rally Championship).
wheel_button_gear_1 = 18
wheel_button_gear_2 = 19
wheel_button_gear_3 = 20
wheel_button_gear_4 = 21
wheel_button_gear_neutral = 16
# With an H shifter bound: its lever in none of the gears is in neutral,
# as on the cabinet. Off, the last gear stays until another is chosen.
wheel_shifter_neutral = false
# A paddle or RB/LB shift from one gear to another passes through
# neutral this long, in ms, as a lever crosses the gate; 0 shifts
# straight. 0..500.
wheel_shift_neutral_ms = 100
# Wheel axes, or -1 to auto-detect (steering axis 0; pedals by rest
# position). Set by the GUI calibration when a wheel differs.
wheel_steer_axis = 0
wheel_accel_axis = 1
wheel_brake_axis = 2
wheel_accel_invert = true
wheel_brake_invert = true
# A pedal on half of its axis, released at the centre: pressed towards
# the high end, or the low end when inverted (Y-).
wheel_accel_half = true
wheel_brake_half = true

# Light-gun buttons, per player, as raw Linux evdev key codes (0
# unbinds). Trigger fires, reload is the off-screen reload / missile,
# coin and start are the operator inputs, hat_* are a gun's D-pad.
# Defaults suit a Sinden: BTN_LEFT 0x110, BTN_RIGHT 0x111, BTN_1..8
# 0x101..0x108.
gun1_button_trigger = 272
gun1_button_reload = 273
gun1_button_coin = 257
gun1_button_start = 258
gun1_button_hat_up = 261
gun1_button_hat_down = 262
gun1_button_hat_left = 263
gun1_button_hat_right = 264
gun2_button_trigger = 272
gun2_button_reload = 273
gun2_button_coin = 257
gun2_button_start = 258
gun2_button_hat_up = 261
gun2_button_hat_down = 262
gun2_button_hat_left = 263
gun2_button_hat_right = 264

# SCSP sound chip emulation for the Model 2A/2B/2C sound board: mame
# or mednafen (being brought over, see SCSP.md). Applies from the
# next game launch; a save state only loads with the core it was
# made with.
scsp_core = mednafen

# Per-game volume, 0..150 percent of the default (100). One
# volume_<parent set> line per game family, e.g. volume_srallyc.
game_volume = false

# Where the ROM archives live. A game launched by name with no
# explicit path is loaded from <rom_dir>/<name>.zip or .7z.
rom_dir = ..\MameRoms

# Saves: per-game .nv and .eeprom (scores, settings).
nvram_dir = saves

# Where F12 screenshots are written.
screenshot_dir = screenshots

# Let the game picker fetch box art and descriptions from ArcadeDB
# over the network. Off keeps the emulator offline: the picker still
# lists and launches every game, with placeholder tiles and no text.
scrape_artwork = true

# Vulkan validation layers. Slow, and only useful when developing.
validation = false

# trace, debug, info, warning or error.
log_level = info

# Gamepad buttons, per player, as SDL_GamepadButton values (-1
# unbinds). button1..4 are the arcade buttons, up/down/left/right the
# joystick gate, start/coin the operator inputs, gear_up/gear_down
# the shift. Defaults are the positional SDL layout: South 0 East 1
# West 2 North 3 -> button1..4, DpadUp 11 DpadDown 12 DpadLeft 13
# DpadRight 14, Start 6, Back 4, RightShoulder 10, LeftShoulder 9.
# 100 + an axis number is that axis pushed past half travel (a trigger
# pulled, a stick right or down); 200 + axis is the other direction.
# Gamepad analogue axes, per player, as SDL_GamepadAxis values (-1
# keeps the default: aim on the left stick, accel on the right trigger,
# brake on the left trigger, Virtual On's lever on the right stick).
# LeftX 0 LeftY 1 RightX 2 RightY 3 LeftTrigger 4 RightTrigger 5. An
# *_invert flag reverses an axis that reads the wrong way; a pedal's
# *_button is a binding that floors it while held (-1 none).
# [gamepad] is the default layout. A [family] section, named after
# the parent set, replaces it for every version of that game and only
# needs the bindings that differ. Delete one to use [gamepad] again.

[gamepad]
pad1_button_button1 = 0
pad1_button_button2 = 1
pad1_button_button3 = 2
pad1_button_button4 = 3
pad1_button_up = 11
pad1_button_down = 12
pad1_button_left = 13
pad1_button_right = 14
pad1_button_start = 6
pad1_button_coin = 4
pad1_button_gear_up = 10
pad1_button_gear_down = 9
pad2_button_button1 = 0
pad2_button_button2 = 1
pad2_button_button3 = 2
pad2_button_button4 = 3
pad2_button_up = 11
pad2_button_down = 12
pad2_button_left = 13
pad2_button_right = 14
pad2_button_start = 6
pad2_button_coin = 4
pad2_button_gear_up = 10
pad2_button_gear_down = 9
pad1_axis_aim_x = -1
pad1_axis_aim_x_invert = false
pad1_axis_aim_y = -1
pad1_axis_aim_y_invert = false
pad1_axis_accel = -1
pad1_axis_accel_invert = false
pad1_axis_accel_button = -1
pad1_axis_brake = -1
pad1_axis_brake_invert = false
pad1_axis_brake_button = -1
pad1_axis_lever_x = -1
pad1_axis_lever_y = -1
pad2_axis_aim_x = -1
pad2_axis_aim_x_invert = false
pad2_axis_aim_y = -1
pad2_axis_aim_y_invert = false
pad2_axis_accel = -1
pad2_axis_accel_invert = false
pad2_axis_accel_button = -1
pad2_axis_brake = -1
pad2_axis_brake_invert = false
pad2_axis_brake_button = -1
pad2_axis_lever_x = -1
pad2_axis_lever_y = -1
